# Local dev default - set APP_URL=https://app.drcyber.ca in production
APP_URL=http://localhost:3000
DATABASE_URL=mysql://drcyber:password@localhost:3306/drcyber
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
STUDENT_SESSION_SECRET=replace-with-a-different-long-random-secret

BOOKING_LINK=https://calendly.com/your-team/cyber-career-roadmap-call
MASTERCLASS_LINK=https://example.com/masterclass
ADMIN_NOTIFICATION_EMAIL=team@example.com
DEFAULT_SENDER_NAME=Dr Cyber Team
PROGRAM_COHORT_NAME=Dr Cyber Switch Program
# Optional override - defaults to {APP_URL}/images/logo.jpg (the logo already in the repo)
LOGO_URL=

EMAIL_PROVIDER=console
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Dr Cyber Team <hello@example.com>

SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

WEBHOOK_SHARED_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Stripe (TEST MODE ONLY until go-live; never commit real keys) ---
# STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY / STRIPE_WEBHOOK_SECRET are listed above.
# A live key (sk_live_/rk_live_) is refused unless this is set to true at go-live (Phase 5):
STRIPE_ALLOW_LIVE=false

# --- Cloudflare R2 (use a SEPARATE dev bucket for now; private bucket, bucket-scoped API token) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Protected COURSE VIDEO uses its own bucket + its own bucket-scoped token, so it never shares credentials with the
# uploads bucket above. Set all four, or none (none = video falls back to the R2_* values above). Setting only some is an error.
R2_VIDEO_ACCOUNT_ID=
R2_VIDEO_ACCESS_KEY_ID=
R2_VIDEO_SECRET_ACCESS_KEY=
R2_VIDEO_BUCKET_NAME=

# --- Cloudflare Turnstile (bot check on signup + checkout). In PRODUCTION these are mandatory: signup/checkout refuse without the secret.
# Cloudflare's always-pass TEST keys for local dev: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email the admin when this many payments fail within 10 minutes (card-testing tripwire)
FAILED_PAYMENT_ALERT_THRESHOLD=5

# --- 1x1 coaching funnel / CRM ---
# Booking page for the "Book a 1x1 with Dr_Cyber" button (falls back to BOOKING_LINK)
BOOKING_LINK_1X1=
# Your business mailing address, printed in the footer of promotional email (CASL requires sender identification + address)
BUSINESS_ADDRESS=
# Calendly webhook signing key. In production the CRM only moves a student to "Booked 1x1" from a request signed with this key.
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Production hardening ---
# /admin/register (first-run admin creation) is CLOSED in production unless this is "true". Prefer ADMIN_EMAIL + ADMIN_PASSWORD_HASH.
ALLOW_ADMIN_REGISTER=false

# --- Legal pages (/terms, /privacy, /refunds). Unset values show as [PLACEHOLDERS] on the pages. ---
BUSINESS_LEGAL_NAME=
SUPPORT_EMAIL=
LEGAL_GOVERNING_PROVINCE=
# Days a customer can ask for a refund after purchase (default 7). Your policy, so set it deliberately.
REFUND_WINDOW_DAYS=7
# Remove the "Draft - not yet reviewed" banner ONLY after a lawyer has reviewed all three pages
LEGAL_PAGES_REVIEWED=false

# When "true", an admin who has not enrolled two-step verification can only reach /admin/security until they do.
# Enroll at /admin/security FIRST, then turn this on.
ADMIN_REQUIRE_MFA=false

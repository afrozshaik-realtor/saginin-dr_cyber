LOGO_URL=

EMAIL_PROVIDER=console
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Dr Cyber Team <hello@example.com>

SMS_ENABLED=false
